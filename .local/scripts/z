#!/usr/bin/env bash

NOTE_DIR="$HOME/.dotfiles/.local/notes"
TEMPLATE="$NOTE_DIR/template.md"

CONTEXT=$1
NEOVIM_FILE=$2
NEOVIM_LINE=$3

# Gather existing tags from all notes
EXISTING_TAGS=$(grep -h "^Tags:" "$NOTE_DIR"/*.md 2>/dev/null | sed 's/^Tags: //' | tr ',' '\n' | sort -u)

# Prompt for title
echo -n "Title: "
read title

# Prompt for tags using fzf (multi-select + allow new)
TAGS=$(echo -e "$EXISTING_TAGS" | fzf --multi --prompt="Tags> " --cycle --reverse)
# Prompt for additional new tags
read -rp "Additional new tags (comma-separated): " NEW_TAGS

# Flatten fzf selections into comma-separated string
TAGS_CSV=$(echo "$TAGS" | tr '\n' ',' | sed 's/,$//')

# Combine selected + new tags
if [ -n "$TAGS_CSV" ]; then
    if [ -n "$NEW_TAGS" ]; then
        ALL_TAGS="$TAGS_CSV,$NEW_TAGS"
    else
        ALL_TAGS="$TAGS_CSV"
    fi
else
    ALL_TAGS="$NEW_TAGS"
fi

# Prepare note file
ID=$(date +"%Y%m%d_%H%M%S")
SAFE_TITLE=$(echo "$title" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_]/_/g')
NOTE_FILE="$NOTE_DIR/${ID}__${SAFE_TITLE}.md"

cp "$TEMPLATE" "$NOTE_FILE"
sed -i "s/{{title}}/$title/g" "$NOTE_FILE"
sed -i "s/{{tag}}/$ALL_TAGS/g" "$NOTE_FILE"
sed -i "s/^Date:.*/Date: $(date +'%Y-%m-%d %H:%M:%S')/" "$NOTE_FILE"

# Insert automatic reference if in nvim context
if [ "$CONTEXT" == "nvim" ] && [ -n "$NEOVIM_FILE" ]; then
    FILE_PATH=$(realpath "$NEOVIM_FILE")
    REF="- [[$FILE_PATH#L$NEOVIM_LINE]]"
    if grep -q "^References:" "$NOTE_FILE"; then
        sed -i "/^References:/a $REF" "$NOTE_FILE"
    else
        echo -e "References:\n$REF" >> "$NOTE_FILE"
    fi
fi

# References for qutebrowser (URL passed as argument)
if [ "$CONTEXT" == "qutebrowser" ] && [ -n "$URL" ]; then
    REF="- [[$URL]]"
    if grep -q "^References:" "$NOTE_FILE"; then
        sed -i "/^References:/a $REF" "$NOTE_FILE"
    else
        echo -e "References:\n$REF" >> "$NOTE_FILE"
    fi
fi

# Open in nvim
exec nvim "$NOTE_FILE"
