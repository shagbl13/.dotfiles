# i3 config file (v4)
set $mod Mod4
font pango:SauceCodeProNerdFontMono Regular 9

# Start XDG autostart .desktop files
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

floating_modifier $mod

# --- Basic bindings ---
bindsym $mod+Return exec alacritty
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id dmenu_run
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right


#Assign application to a specific workspace
assign [class="qutebrowser"] number $ws2
assign [class="firefox"] number $ws2
assign [class="Google-chrome"] number $ws9
assign [class="EpubReader"] number $ws5
assign [class="hakuneko-desktop"] number $ws5
assign [class="PlayOnLinux"] number $ws5
assign [class="ktouch"] number $ws5
assign [class="vlc"] number $ws5
assign [class="mpv"] number $ws5
assign [class="Alacritty"] number $ws1
assign [class="discord"] number $ws0
assign [class="TelegramDesktop"] number $ws0
assign [class="Postman"] number $ws3
assign [class="qBittorrent"] number $ws5
assign [class="Houdoku"] number $ws5
assign [class="Mangayomi"] number $ws5
assign [class="Inscape"] number $ws7
assign [class="Gimp"] number $ws7
assign [class="teamlogger"] number $ws3


for_window [class="Xdm-app" ] floating enable
for_window [class="pavucontrol" ] floating enable
for_window [class="dolphin" ] floating enable
for_window [window_role="pop-up"] floating enable

popup_during_fullscreen smart
# Zettel global bindings
bindsym $mod+Shift+n exec --no-startup-id alacritty -t Zettel -e $HOME/.dotfiles/.local/scripts/z nvim
bindsym $mod+Shift+t exec --no-startup-id alacritty -t TODO -e $HOME/.dotfiles/.local/scripts/todo
bindsym $mod+Shift+o exec --no-startup-id alacritty -t Zettel -e nvim $HOME/.dotfiles/.local/notes/

# Start apps
bindsym $mod+b exec firefox
bindsym $mod+g exec google-chrome-stable
bindsym $mod+Shift+g exec gimp
bindsym $mod+q exec qutebrowser
bindsym $mod+t exec telegram-desktop
bindsym $mod+c exec discord
bindsym $mod+m exec vlc
bindsym $mod+\ exec pavucontrol

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split and layout
bindsym $mod+semicolon split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle

# Workspace switching
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws0 "0"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws0

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws0

# Automatically focus the Zettel terminal when it appears
for_window [title="Zettel"] focus

# Reload, restart, exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Bar
bar {
    status_command i3status
    position top
}

# Autostart apps and settings
exec_always --no-startup-id pa-applet &
exec_always --no-startup-id nm-applet &
exec_always --no-startup-id discord &
exec_always --no-startup-id picom --no-fading-openclose &
exec_always --no-startup-id setxkbmap -layout 'us,fr,us' -variant ',,dvorak' -option 'grp:shifts_toggle,ctrl:swapcaps'
exec_always --no-startup-id xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Tapping Enabled" 1
exec_always --no-startup-id feh --bg-scale ~/.dotfiles/bg/wallpaperflare.com_wallpaper.jpg
exec_always --no-startup-id qutebrowser
exec_always --no-startup-id alacritty
